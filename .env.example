# auto-x environment template — copy to .env and fill secrets
#   cp .env.example .env

# Required. Boot fails if empty, length < 16, or equals change-me-to-long-random
ADMIN_TOKEN=dev-admin-token-32chars-min

PORT=3000

# PostgreSQL (compose service name: postgres)
POSTGRES_USER=autox
# Required. Prefer URL-safe chars only (A-Za-z0-9._~-)
POSTGRES_PASSWORD=autox_dev_pass
POSTGRES_DB=autox
DATABASE_URL=postgres://autox:autox_dev_pass@postgres:5432/autox

PG_POOL_MAX=10
LOG_LEVEL=info
CORS_ORIGIN=*

# X (Twitter) OAuth 1.0a — only needed when X_CLIENT_MODE=live
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# mock | live  — default mock for local E2E
X_CLIENT_MODE=mock

OBSERVATION_DAYS=7
MAX_FOLLOWS_PER_DAY=50
MAX_UNFOLLOWS_PER_DAY=50
MAX_FOLLOWS_PER_HOUR=8
MAX_UNFOLLOWS_PER_HOUR=8
# mock uses short interval via shared settings default
WRITE_MIN_INTERVAL_MS=200
FOLLOW_BACK_ENABLED=true
MUTUAL_EXPAND_ENABLED=false
CANDIDATE_MANUAL_APPROVAL=true
UNFOLLOW_COOLDOWN_DAYS=30
LEASE_TTL_SEC=120
WORKER_ID=worker-1
EXPAND_PREFER_VERIFIED=true
