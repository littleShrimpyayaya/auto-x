# auto-x — copy to .env and fill secrets
#   cp .env.example .env

# Required admin auth (length >= 16, not the placeholder)
ADMIN_TOKEN=change-me-to-a-long-random-token

PORT=3000

# PostgreSQL
POSTGRES_USER=autox
POSTGRES_PASSWORD=autox_dev_pass
POSTGRES_DB=autox
DATABASE_URL=postgres://autox:autox_dev_pass@postgres:5432/autox

PG_POOL_MAX=10
LOG_LEVEL=info
CORS_ORIGIN=*

# ─── X (Twitter) REAL API ─────────────────────────────────────────
# OAuth 1.0a User Context (Developer Portal → Project → App → Keys)
# Required for live operation:
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# live | mock | auto
#   auto  = use live when all 4 keys are set, otherwise mock
#   live  = always real API (fails boot if keys missing)
#   mock  = offline simulation only
X_CLIENT_MODE=auto

# Allow follow/unfollow writes (set 0 for read-only sync)
X_ENABLE_WRITES=1

# API retry on 429
X_API_MAX_RETRIES=5

# ─── Automation pacing (live-safe defaults applied when live) ─────
OBSERVATION_DAYS=7
MAX_FOLLOWS_PER_DAY=40
MAX_UNFOLLOWS_PER_DAY=40
MAX_FOLLOWS_PER_HOUR=6
MAX_UNFOLLOWS_PER_HOUR=6
WRITE_MIN_INTERVAL_MS=45000
SYNC_PAGE_SIZE=100
SYNC_PAGE_DELAY_MS=1100
FOLLOW_BACK_ENABLED=true
MUTUAL_EXPAND_ENABLED=false
CANDIDATE_MANUAL_APPROVAL=true
UNFOLLOW_COOLDOWN_DAYS=30
LEASE_TTL_SEC=120
WORKER_ID=worker-1
EXPAND_PREFER_VERIFIED=true
