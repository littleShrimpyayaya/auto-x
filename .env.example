# auto-x environment template — copy to .env and fill secrets
#   cp .env.example .env

# Required. Boot fails if empty, length < 16, or equals change-me-to-long-random
ADMIN_TOKEN=

PORT=3000

# PostgreSQL (compose service name: postgres)
POSTGRES_USER=autox
POSTGRES_PASSWORD=
POSTGRES_DB=autox
# Inside compose network:
DATABASE_URL=postgres://autox:${POSTGRES_PASSWORD}@postgres:5432/autox
# Local dev without compose network:
# DATABASE_URL=postgres://autox:secret@127.0.0.1:5432/autox

PG_POOL_MAX=10
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:*

# X (Twitter) OAuth 1.0a user context
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_CLIENT_MODE=live

OBSERVATION_DAYS=7
MAX_FOLLOWS_PER_DAY=50
MAX_UNFOLLOWS_PER_DAY=50
MAX_FOLLOWS_PER_HOUR=8
MAX_UNFOLLOWS_PER_HOUR=8
WRITE_MIN_INTERVAL_MS=45000
FOLLOW_BACK_ENABLED=true
MUTUAL_EXPAND_ENABLED=false
CANDIDATE_MANUAL_APPROVAL=true
UNFOLLOW_COOLDOWN_DAYS=30
LEASE_TTL_SEC=120
WORKER_ID=worker-1
