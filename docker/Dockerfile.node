# Multi-stage Node 20 image for api / worker / migrate (PR1 scaffold).
# Build: docker compose build api|worker|migrate
# ARG APP selects which workspace package to run at container start.

FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app

# --- deps ---
FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/
COPY packages/db/package.json ./packages/db/
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/package.json ./packages/config/
COPY packages/x-client/package.json ./packages/x-client/
COPY packages/domain/package.json ./packages/domain/
RUN pnpm install --frozen-lockfile || pnpm install

# --- runtime ---
FROM base AS runtime
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps ./apps
COPY --from=deps /app/packages ./packages
COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages

ARG APP=api
ENV APP=${APP}
ENV NODE_ENV=production

# Default command overridden per service in docker-compose.yml
CMD ["sh", "-c", "case \"$APP\" in api) pnpm --filter @autox/api start ;; worker) pnpm --filter @autox/worker start ;; migrate) pnpm --filter @autox/db db:migrate ;; *) echo \"unknown APP=$APP\" >&2; exit 1 ;; esac"]
