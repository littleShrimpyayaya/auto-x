# Node 20 image for api / worker / migrate (PR1 scaffold).
# Build: docker compose build api|worker|migrate
# ARG APP selects which workspace package to run at container start.
#
# Layout: copy full monorepo source first, then pnpm install so package
# node_modules (and .bin/tsx) are created against this tree and never overwritten.

FROM node:20-alpine
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages

# Fail the build on lockfile drift. tsx is a production dependency (PR1 entrypoint).
RUN pnpm install --frozen-lockfile

ARG APP=api
ENV APP=${APP}
ENV NODE_ENV=production

# Default command overridden per service in docker-compose.yml
CMD ["sh", "-c", "case \"$APP\" in api) pnpm --filter @autox/api start ;; worker) pnpm --filter @autox/worker start ;; migrate) pnpm --filter @autox/db db:migrate ;; *) echo \"unknown APP=$APP\" >&2; exit 1 ;; esac"]
