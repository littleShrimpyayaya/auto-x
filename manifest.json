{
  "manifest_version": 3,
  "name": "auto-x",
  "version": "0.3.0",
  "description": "X (Twitter) 自动回关 — 跨浏览器纯前端插件，无需后端",
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/lib/browser.js",
      "src/lib/store.js",
      "src/background.js"
    ]
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "auto-x",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.x.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/injector.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "autox@local",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
