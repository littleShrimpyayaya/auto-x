#!/bin/sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PROJECT_ROOT="$(CDPATH= cd -- "${SCRIPT_DIR}/../.." && pwd)"
DEFAULT_CERT_DIR="${SCRIPT_DIR}/certs"
DEFAULT_INSTALL_DIR="${PROJECT_ROOT}/conf/certs"

REDCOLOR='\033[31m'
YELLOWCOLOR='\033[33m'
GREENCOLOR='\033[32m'
BLUECOLOR='\033[36m'
NOCOLOR='\033[0m'

log() {
  printf '%s\n' "$*"
}

color_log() {
  color="$1"
  shift
  printf '%b%s%b\n' "$color" "$*" "$NOCOLOR"
}

info() {
  color_log "$BLUECOLOR" "$*"
}

warn() {
  color_log "$YELLOWCOLOR" "$*"
}

success() {
  color_log "$GREENCOLOR" "$*"
}

die() {
  color_log "$REDCOLOR" "$*" >&2
  exit 1
}

run() {
  log "+ $*"
  "$@"
}

usage() {
  cat <<EOF
Usage:
  $(basename -- "$0") [CERT_DIR]

Environment overrides:
  PASSWD=12345
  ENCRYPTBIT=2048
  DAYS=3650
  SELF_SIGN_CONF=self_sign.cnf
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

if ! command -v openssl >/dev/null 2>&1; then
  die "openssl 未安装或不在 PATH 中。"
fi

CERT_DIR="${1:-$DEFAULT_CERT_DIR}"
PASSWD="${PASSWD:-12345}"
ENCRYPTBIT="${ENCRYPTBIT:-2048}"
DAYS="${DAYS:-3650}"
SELF_SIGN_CONF_NAME="${SELF_SIGN_CONF:-self_sign.cnf}"

case "$CERT_DIR" in
  /*) : ;;
  *) CERT_DIR="$(CDPATH= cd -- "$CERT_DIR" 2>/dev/null && pwd)" || true ;;
esac

if [ ! -d "$CERT_DIR" ]; then
  echo "开始创建: $CERT_DIR"
  mkdir -p $CERT_DIR
fi

SELFSIGNCONF="${SCRIPT_DIR}/${SELF_SIGN_CONF_NAME}"
[ -f "$SELFSIGNCONF" ] || die "找不到配置文件: $SELFSIGNCONF"

CN_VALUE="$(grep -m1 'commonName_default' "$SELFSIGNCONF" | cut -d'=' -f2 | tr -d '[:space:]' || true)"
if [ -z "$CN_VALUE" ]; then
  die "配置文件中的 commonName_default 为空: $SELFSIGNCONF"
fi

SUBJCONTENT="/C=CN/ST=Shanghai/L=Shanghai/O=${CN_VALUE}/OU=${CN_VALUE}/CN=${CN_VALUE}"

CAKEY="ca.key"
CACRT="ca.crt"
SVRPEM="server.pem"
SVRKEY="server.key"
SVRCSR="server.csr"
SVRCRT="server.crt"
CLNPEM="client.pem"
CLNKEY="client.key"
CLNCSR="client.csr"
CLNCRT="client.crt"
CA_SRL="ca.srl"

log ">>> 生成并安装本地自签证书..."
log "Using configuration file: $SELFSIGNCONF"
log "Certificate subject: $SUBJCONTENT"
log "Certificate output dir: $CERT_DIR"
log "Install target dir: $DEFAULT_INSTALL_DIR"
log "Password length: ${#PASSWD}"
log "Key size: $ENCRYPTBIT"
log "Days: $DAYS"
log ""

mkdir -p "$CERT_DIR"
mkdir -p "$(dirname -- "$DEFAULT_INSTALL_DIR")"

cd "$CERT_DIR"

cleanup_old_files() {
  rm -f \
    "$CAKEY" "$CACRT" "$SVRPEM" "$SVRKEY" "$SVRCSR" "$SVRCRT" \
    "$CLNPEM" "$CLNKEY" "$CLNCSR" "$CLNCRT" "$CA_SRL" 2>/dev/null || true
}

cleanup_old_files

step=0

step=$((step + 1))
log "$step generate root ca private key"
run openssl genrsa -passout "pass:$PASSWD" -des3 -out "$CAKEY" "$ENCRYPTBIT"

step=$((step + 1))
log "$step generate root ca public key(crt file) with private key"
warn "$step using password length ${#PASSWD} to read $CAKEY"
run openssl req -passin "pass:$PASSWD" -new -x509 -days "$DAYS" -key "$CAKEY" -out "$CACRT" -subj "$SUBJCONTENT" -config "$SELFSIGNCONF"

step=$((step + 1))
log "$step generate server private key(pem file)"
run openssl genrsa -passout "pass:$PASSWD" -des3 -out "$SVRPEM" "$ENCRYPTBIT"

step=$((step + 1))
log "$step generate server public key with pem"
warn "$step using password length ${#PASSWD} to read $SVRPEM"
run openssl rsa -passin "pass:$PASSWD" -in "$SVRPEM" -out "$SVRKEY"

step=$((step + 1))
log "$step generate server csr file"
warn "$step using password length ${#PASSWD} to read $SVRPEM"
run openssl req -new -passin "pass:$PASSWD" -key "$SVRPEM" -out "$SVRCSR" -subj "$SUBJCONTENT" -config "$SELFSIGNCONF"

step=$((step + 1))
log "$step sign server crt file with root ca crt and root ca key"
warn "$step using password length ${#PASSWD} to read $CAKEY"
run openssl x509 -req -sha256 -in "$SVRCSR" -CA "$CACRT" -CAkey "$CAKEY" -CAcreateserial -passin "pass:$PASSWD" -days "$DAYS" -out "$SVRCRT" -extensions v3_req -extfile "$SELFSIGNCONF"

step=$((step + 1))
log "$step generate client private key(pem file)"
run openssl genrsa -passout "pass:$PASSWD" -des3 -out "$CLNPEM" "$ENCRYPTBIT"

step=$((step + 1))
log "$step generate client public key with pem"
warn "$step using password length ${#PASSWD} to read $CLNPEM"
run openssl rsa -passin "pass:$PASSWD" -in "$CLNPEM" -out "$CLNKEY"

step=$((step + 1))
log "$step generate client csr file"
warn "$step using password length ${#PASSWD} to read $CLNPEM"
run openssl req -new -passin "pass:$PASSWD" -key "$CLNPEM" -out "$CLNCSR" -subj "$SUBJCONTENT" -config "$SELFSIGNCONF"

step=$((step + 1))
log "$step sign client crt file with root ca crt and root ca key"
warn "$step using password length ${#PASSWD} to read $CAKEY"
run openssl x509 -req -sha256 -in "$CLNCSR" -CA "$CACRT" -CAkey "$CAKEY" -CAcreateserial -passin "pass:$PASSWD" -days "$DAYS" -out "$CLNCRT" -extensions v3_req -extfile "$SELFSIGNCONF"

cleanup_install_dir() {
  rm -rf "$DEFAULT_INSTALL_DIR"
}

copy_install_dir() {
  mkdir -p "$(dirname -- "$DEFAULT_INSTALL_DIR")"
  cp -rf "$CERT_DIR" "$DEFAULT_INSTALL_DIR"
}

log ""
log "Removing install dir: $DEFAULT_INSTALL_DIR"
cleanup_install_dir
log "Copying $CERT_DIR -> $DEFAULT_INSTALL_DIR"
copy_install_dir

log ""
log "=========================================="
success "证书生成完成！"
log "证书文件位置: $CERT_DIR"
log "安装目录: $DEFAULT_INSTALL_DIR"
log "配置文件: $SELFSIGNCONF"
log "=========================================="
log ""
log "1. Windows 上面找到证书："
log "   双击 ca.crt 证书 -> 安装证书 -> 本地计算机 ->"
log "   将所有的证书都放入下拉存储，打开浏览 -> 受信任的根证书颁发机构 ->"
log "   下一步，完成"
log ""
log "2. Chrome 浏览器地址栏输入 chrome://certificate-manager/localcerts 打开后："
log "   点击《管理从 Windows 导入的证书》 -> 受信任的根证书颁发机构 -> 导入 ->"
log "   按照引导选择 ca.crt 证书导入完成就可以了。"
log ""
log "3. nginx.conf 里面配置："
log "   ssl_certificate certs/server.crt;"
log "   ssl_certificate_key certs/server.key;"
log "   服务器使用 server.crt 和 server.key，不要使用 ca 根证书。"
log "   当前安装目录: $DEFAULT_INSTALL_DIR"
